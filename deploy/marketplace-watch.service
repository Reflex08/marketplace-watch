[Unit]
Description=Marketplace watcher - search and send alerts
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=mwatch
WorkingDirectory=/opt/marketplace-watch
EnvironmentFile=/etc/marketplace-watch.env
ExecStart=/opt/marketplace-watch/.venv/bin/python -u /opt/marketplace-watch/watch.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
